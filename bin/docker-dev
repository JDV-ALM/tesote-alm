#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Project name
PROJECT_NAME="tesote-odoo"

# Functions
print_header() {
    echo -e "${BLUE}================================================${NC}"
    echo -e "${BLUE}    Tesote Odoo Connector - Docker Dev Tool    ${NC}"
    echo -e "${BLUE}================================================${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${YELLOW}ℹ${NC} $1"
}

# Commands
cmd_up() {
    print_info "Starting Odoo development environment..."
    docker compose up -d

    print_info "Waiting for services to be healthy..."
    sleep 5

    # Wait for Odoo to be ready
    while ! docker compose exec -T odoo curl -s http://localhost:8069/web/health > /dev/null 2>&1; do
        echo -n "."
        sleep 2
    done
    echo ""

    print_success "Odoo is running at http://localhost:8069"
    print_info "Default credentials: admin / admin"
    print_info "Database: tesote_dev"

    if [ "$1" == "--logs" ]; then
        docker compose logs -f
    fi
}

cmd_down() {
    print_info "Stopping Odoo development environment..."
    docker compose down
    print_success "Environment stopped"
}

cmd_restart() {
    print_info "Restarting Odoo..."
    docker compose restart odoo
    print_success "Odoo restarted"
}

cmd_logs() {
    docker compose logs -f "$@"
}

cmd_shell() {
    print_info "Opening Odoo shell..."
    docker compose exec odoo odoo shell -d tesote_dev
}

cmd_bash() {
    print_info "Opening bash shell in Odoo container..."
    docker compose exec odoo bash
}

cmd_psql() {
    print_info "Opening PostgreSQL shell..."
    docker compose exec db psql -U odoo tesote_dev
}

cmd_test() {
    print_info "Running tests in Docker..."
    docker compose exec odoo odoo \
        --test-enable \
        --stop-after-init \
        --log-level=test \
        -d tesote_dev \
        -i tesote_connector
}

cmd_install() {
    print_info "Installing/updating tesote_connector module..."
    docker compose exec odoo odoo \
        -d tesote_dev \
        -u tesote_connector \
        --stop-after-init
    print_success "Module updated"
}

cmd_reset() {
    print_info "Resetting database..."
    read -p "This will delete all data. Continue? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        docker compose down -v
        print_success "Database reset. Run './bin/docker-dev up' to start fresh"
    else
        print_info "Reset cancelled"
    fi
}

cmd_backup() {
    print_info "Creating database backup..."
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    BACKUP_FILE="backups/tesote_dev_${TIMESTAMP}.sql"

    mkdir -p backups
    docker compose exec -T db pg_dump -U odoo tesote_dev > "$BACKUP_FILE"

    if [ -f "$BACKUP_FILE" ]; then
        print_success "Backup created: $BACKUP_FILE"
    else
        print_error "Backup failed"
    fi
}

cmd_restore() {
    if [ -z "$1" ]; then
        print_error "Usage: ./bin/docker-dev restore <backup_file>"
        exit 1
    fi

    if [ ! -f "$1" ]; then
        print_error "Backup file not found: $1"
        exit 1
    fi

    print_info "Restoring database from $1..."
    docker compose exec -T db psql -U odoo tesote_dev < "$1"
    print_success "Database restored"
}

cmd_status() {
    print_header
    echo ""
    docker compose ps
    echo ""

    # Check Odoo health
    if docker compose exec -T odoo curl -s http://localhost:8069/web/health > /dev/null 2>&1; then
        print_success "Odoo is healthy"
    else
        print_error "Odoo is not responding"
    fi

    # Check database
    if docker compose exec -T db pg_isready -U odoo > /dev/null 2>&1; then
        print_success "PostgreSQL is healthy"
    else
        print_error "PostgreSQL is not responding"
    fi
}

cmd_clean() {
    print_info "Cleaning up Docker resources..."
    docker compose down --rmi local --volumes --remove-orphans
    print_success "Cleanup complete"
}

# Main script
case "$1" in
    up)
        cmd_up "$2"
        ;;
    down)
        cmd_down
        ;;
    restart)
        cmd_restart
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    shell)
        cmd_shell
        ;;
    bash)
        cmd_bash
        ;;
    psql)
        cmd_psql
        ;;
    test)
        cmd_test
        ;;
    install)
        cmd_install
        ;;
    reset)
        cmd_reset
        ;;
    backup)
        cmd_backup
        ;;
    restore)
        cmd_restore "$2"
        ;;
    status)
        cmd_status
        ;;
    clean)
        cmd_clean
        ;;
    *)
        print_header
        echo ""
        echo "Usage: ./bin/docker-dev <command> [options]"
        echo ""
        echo "Commands:"
        echo "  up [--logs]  Start the development environment"
        echo "  down         Stop the development environment"
        echo "  restart      Restart Odoo container"
        echo "  logs [service] Show logs (follow mode)"
        echo "  shell        Open Odoo Python shell"
        echo "  bash         Open bash shell in Odoo container"
        echo "  psql         Open PostgreSQL shell"
        echo "  test         Run module tests"
        echo "  install      Install/update tesote_connector module"
        echo "  reset        Reset database (delete all data)"
        echo "  backup       Create database backup"
        echo "  restore <file> Restore database from backup"
        echo "  status       Show environment status"
        echo "  clean        Clean up all Docker resources"
        echo ""
        echo "Examples:"
        echo "  ./bin/docker-dev up          # Start environment"
        echo "  ./bin/docker-dev logs odoo   # View Odoo logs"
        echo "  ./bin/docker-dev test        # Run tests"
        echo "  ./bin/docker-dev shell       # Open Python shell"
        ;;
esac
