<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View for Webhook Config -->
    <record id="tesote_webhook_config_tree" model="ir.ui.view">
        <field name="name">tesote.webhook.config.tree</field>
        <field name="model">tesote.webhook.config</field>
        <field name="arch" type="xml">
            <tree string="Webhook Configurations" create="false" delete="false">
                <field name="backend_id"/>
                <field name="webhook_url"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="active_events" widget="many2many_tags"/>
                <field name="last_verified"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Webhook Config -->
    <record id="tesote_webhook_config_form" model="ir.ui.view">
        <field name="name">tesote.webhook.config.form</field>
        <field name="model">tesote.webhook.config</field>
        <field name="arch" type="xml">
            <form string="Webhook Configuration">
                <header>
                    <button name="action_test_webhook" type="object" string="Test Webhook" class="btn-primary" attrs="{'invisible': [('enabled', '=', False)]}"/>
                    <button name="action_verify_signature" type="object" string="Verify Signature" attrs="{'invisible': [('enabled', '=', False)]}"/>
                    <button name="action_regenerate_secret" type="object" string="Regenerate Secret" confirm="Are you sure you want to regenerate the webhook secret? This will invalidate the current webhook configuration." class="btn-warning"/>
                    <field name="enabled" widget="boolean_toggle" class="float-right"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="backend_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Endpoint Configuration">
                            <field name="webhook_url" readonly="1" widget="url" help="Use this URL in your tesote.com webhook settings"/>
                            <field name="webhook_path" readonly="1" help="Internal webhook path"/>
                            <field name="secret_key" password="True" readonly="1" help="Webhook secret for signature verification (click to reveal)"/>
                            <field name="enabled"/>
                        </group>
                        <group string="Event Subscriptions">
                            <field name="active_events" widget="many2many_checkboxes" help="Select which events to process">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                    <group>
                        <group string="Verification Status">
                            <field name="last_verified" readonly="1"/>
                            <field name="verification_status" readonly="1"/>
                            <field name="last_error" readonly="1" attrs="{'invisible': [('verification_status', '!=', 'failed')]}"/>
                        </group>
                        <group string="Statistics" attrs="{'invisible': [('enabled', '=', False)]}">
                            <field name="total_received" readonly="1"/>
                            <field name="total_processed" readonly="1"/>
                            <field name="total_failed" readonly="1"/>
                            <field name="success_rate" readonly="1" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration Details">
                            <group>
                                <field name="retry_max_attempts"/>
                                <field name="retry_backoff_base"/>
                                <field name="timeout_seconds"/>
                            </group>
                        </page>
                        <page string="Recent Events" attrs="{'invisible': [('enabled', '=', False)]}">
                            <field name="recent_webhook_events" readonly="1">
                                <tree>
                                    <field name="event_id"/>
                                    <field name="event_type"/>
                                    <field name="status" decoration-success="status == 'completed'" decoration-warning="status == 'processing'" decoration-danger="status == 'failed'"/>
                                    <field name="received_at"/>
                                    <field name="processing_duration"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Monitoring Alerts">
                            <group>
                                <field name="alert_on_failure"/>
                                <field name="alert_threshold" attrs="{'invisible': [('alert_on_failure', '=', False)]}"/>
                                <field name="alert_email_to" attrs="{'invisible': [('alert_on_failure', '=', False)]}" widget="email"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Webhook Config -->
    <record id="tesote_webhook_config_search" model="ir.ui.view">
        <field name="name">tesote.webhook.config.search</field>
        <field name="model">tesote.webhook.config</field>
        <field name="arch" type="xml">
            <search string="Search Webhook Configurations">
                <field name="backend_id"/>
                <filter name="enabled" string="Enabled" domain="[('enabled', '=', True)]"/>
                <filter name="disabled" string="Disabled" domain="[('enabled', '=', False)]"/>
                <filter name="verified" string="Verified" domain="[('verification_status', '=', 'verified')]"/>
                <filter name="failed" string="Failed" domain="[('verification_status', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_backend" string="Backend" context="{'group_by': 'backend_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'verification_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Webhook Config -->
    <record id="action_tesote_webhook_config" model="ir.actions.act_window">
        <field name="name">Webhook Configuration</field>
        <field name="res_model">tesote.webhook.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_enabled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure webhook settings for real-time synchronization
            </p>
            <p>
                Webhooks allow tesote.com to notify your Odoo instance immediately when data changes occur.
                This enables real-time synchronization without the need for periodic polling.
            </p>
        </field>
    </record>

    <!-- Menu Item for Webhook Config -->
    <menuitem id="menu_tesote_webhook_config"
              parent="menu_tesote_configuration"
              action="action_tesote_webhook_config"
              sequence="30"
              groups="connector.group_connector_manager"/>
</odoo>