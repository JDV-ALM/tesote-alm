<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="tesote_webhook_secret_wizard_form" model="ir.ui.view">
        <field name="name">tesote.webhook.secret.wizard.form</field>
        <field name="model">tesote.webhook.secret.wizard</field>
        <field name="arch" type="xml">
            <form string="Webhook Secret Key">
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">
                        <i class="fa fa-link"/> Webhook Configuration
                    </h4>
                    <p>Use these values to configure webhooks in equipo.tesote.com</p>
                </div>
                
                <group>
                    <group string="Webhook Endpoint">
                        <field name="webhook_url" widget="CopyClipboardChar" readonly="1"/>
                    </group>
                    <group string="Authentication">
                        <field name="secret_key" widget="CopyClipboardChar" readonly="1"/>
                    </group>
                </group>
                
                <group>
                    <field name="instructions" nolabel="1"/>
                </group>
                
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>