<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Hourly Alert Check -->
        <record id="ir_cron_webhook_alert_check" model="ir.cron">
            <field name="name">Tesote: Check Webhook Alerts</field>
            <field name="model_id" ref="model_tesote_webhook_monitor"/>
            <field name="state">code</field>
            <field name="code">env['tesote.webhook.monitor'].check_alert_conditions()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <!-- Daily Report Generation -->
        <record id="ir_cron_webhook_daily_report" model="ir.cron">
            <field name="name">Tesote: Generate Webhook Daily Report</field>
            <field name="model_id" ref="model_tesote_webhook_monitor"/>
            <field name="state">code</field>
            <field name="code">monitor = env['tesote.webhook.monitor']
report = monitor.generate_daily_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Weekly Cleanup -->
        <record id="ir_cron_webhook_cleanup" model="ir.cron">
            <field name="name">Tesote: Cleanup Old Webhook Data</field>
            <field name="model_id" ref="model_tesote_webhook_monitor"/>
            <field name="state">code</field>
            <field name="code">env['tesote.webhook.monitor'].cleanup_old_monitors(days=90)
env['tesote.webhook.event'].cleanup_old_events(days=90)</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Webhook Metrics Update (every 5 minutes) -->
        <record id="ir_cron_webhook_metrics_update" model="ir.cron">
            <field name="name">Tesote: Update Webhook Metrics</field>
            <field name="model_id" ref="model_tesote_webhook_event"/>
            <field name="state">code</field>
            <field name="code">env['tesote.webhook.monitor'].update_recent_metrics()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>