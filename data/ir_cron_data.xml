<odoo>
    <!-- Scheduled Transaction Sync -->
    <record id="ir_cron_tesote_sync_transactions" model="ir.cron">
        <field name="name">Tesote: Sync Transactions</field>
        <field name="model_id" ref="model_tesote_backend"/>
        <field name="state">code</field>
        <field name="code">model._scheduler_sync_transactions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Scheduled Account Import (runs less frequently) -->
    <record id="ir_cron_tesote_import_accounts" model="ir.cron">
        <field name="name">Tesote: Import Accounts</field>
        <field name="model_id" ref="model_tesote_backend"/>
        <field name="state">code</field>
        <field name="code">model._scheduler_import_accounts()</field>
        <field name="interval_number">24</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
